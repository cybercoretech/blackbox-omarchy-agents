#!/usr/bin/env python3
"""Emit Omarchy agent-panel records for locally stored third-party histories."""
import json
import os
import re
import shutil
import sqlite3
import subprocess
import urllib.request
from collections import defaultdict
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

OUT = Path.home() / ".local/state/omarchy/agents/usage"
DAYS = [(date.today() - timedelta(days=n)).isoformat() for n in range(6, -1, -1)]


def blank():
    return {"todayPrompts": 0, "todaySessions": 0, "todayTotalTokens": 0,
            "todayTokensByModel": {}, "recentDays": {day: 0 for day in DAYS},
            "totalPrompts": 0, "totalSessions": 0, "activeDays": 0,
            "activeDates": set(), "modelUsage": {}}


def add(stats, day, model, prompts=0, sessions=0, input_tokens=0,
        output_tokens=0, cache_read=0, cache_write=0, tokens=0):
    stats["totalPrompts"] += int(prompts or 0)
    stats["totalSessions"] += int(sessions or 0)
    amount = int(tokens or 0) or int(input_tokens or 0) + int(output_tokens or 0) + int(cache_read or 0) + int(cache_write or 0)
    if day:
        stats["activeDates"].add(day)
    if day in stats["recentDays"]:
        stats["recentDays"][day] += amount
        if day == DAYS[-1]:
            stats["todayPrompts"] += int(prompts or 0)
            stats["todaySessions"] += int(sessions or 0)
            stats["todayTotalTokens"] += amount
            if amount:
                stats["todayTokensByModel"][model or "unknown"] = stats["todayTokensByModel"].get(model or "unknown", 0) + amount
    # Prompt/session-only calls carry no model; don't invent an empty row.
    if not amount:
        return
    bucket = stats["modelUsage"].setdefault(model or "unknown", {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
    bucket["inputTokens"] += int(input_tokens or 0)
    bucket["outputTokens"] += int(output_tokens or 0)
    bucket["cacheReadInputTokens"] += int(cache_read or 0)
    bucket["cacheCreationInputTokens"] += int(cache_write or 0)


def day(value):
    # Crush and OpenCode mix second and millisecond stamps (Crush's own
    # updated_at trigger writes seconds into a "milliseconds" column), so
    # detect the unit instead of trusting the schema comment.
    try:
        stamp = float(value)
        if stamp > 1e11:
            stamp /= 1000
        return datetime.fromtimestamp(stamp).date().isoformat()
    except (TypeError, ValueError, OSError, OverflowError):
        pass
    try:  # Copilot stores ISO-8601 strings
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).astimezone().date().isoformat()
    except (ValueError, OverflowError, OSError):
        return None


def connect(path):
    if not path.exists():
        return None
    try:
        return sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    except sqlite3.Error:
        return None


def model_id(value):
    """Reduce a provider-qualified model to the bare hyphenated id the panel
    prettifies: openrouter's `poolside/laguna-s-2.1:free` -> `laguna-s-2.1`.
    OpenCode stores the model as a JSON object, so unwrap that first."""
    if isinstance(value, str) and value.startswith("{"):
        try:
            value = json.loads(value).get("modelID")
        except (ValueError, AttributeError):
            pass
    if not value:
        return "unknown"
    return str(value).rsplit("/", 1)[-1].split(":", 1)[0] or "unknown"


def openrouter_key():
    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if key:
        return key
    # The systemd timer doesn't source the shell rc that exports the key.
    try:
        rc = (Path.home() / ".bashrc").read_text()
    except OSError:
        return ""
    match = re.search(r"^\s*export\s+OPENROUTER_API_KEY=(['\"]?)([^'\"\s]+)\1", rc, re.M)
    return match.group(2) if match else ""


_openrouter = None


def openrouter_limits():
    """Crush and OpenCode both run on the same OpenRouter key, so they share
    its limits: the free-model daily request cap (resets 00:00 UTC) and, on a
    paid key, the key's credit cap. Fetched once per run."""
    global _openrouter
    if _openrouter is not None:
        return _openrouter
    _openrouter = {}
    key = openrouter_key()
    if not key:
        return _openrouter
    request = urllib.request.Request("https://openrouter.ai/api/v1/key",
                                     headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            data = json.load(response).get("data") or {}
    except (OSError, ValueError):
        return _openrouter
    limits = []
    free = data.get("free_model_daily_requests") or {}
    if free.get("limit"):
        midnight = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)
        limits.append({"label": "Free requests (daily)", "title": "Daily",
                       "percent": round(free.get("used", 0) / free["limit"], 4),
                       "resetsAt": midnight.isoformat()})
    if not data.get("is_free_tier") and data.get("limit"):
        limits.append({"label": "Credit cap", "title": "Credit cap",
                       "percent": round((data.get("usage") or 0) / data["limit"], 4)})
    _openrouter = {"limits": limits,
                   "tierLabel": "OpenRouter free" if data.get("is_free_tier") else "OpenRouter"}
    return _openrouter


def json_objects(path):
    """Yield JSON objects from JSONL files or JSON arrays/objects."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return
    try:
        value = json.loads(text)
    except ValueError:
        for line in text.splitlines():
            try:
                value = json.loads(line)
            except ValueError:
                continue
            if isinstance(value, dict):
                yield value
        return
    if isinstance(value, list):
        for item in value:
            if isinstance(item, dict):
                yield item
    elif isinstance(value, dict):
        yield value


def event_value(event, *keys):
    for key in keys:
        value = event.get(key)
        if value not in (None, ""):
            return value
    return None


def collect_event_files(agent_id, name, roots, patterns):
    """Collect prompt/session/token facts from provider-owned event files."""
    stats = blank()
    files = []
    for root in roots:
        if not root.exists():
            continue
        for pattern in patterns:
            files.extend(root.rglob(pattern))
    seen_sessions = set()
    for path in sorted(set(files)):
        for event in json_objects(path):
            when = day(event_value(event, "timestamp", "createdAt", "created_at", "time", "date"))
            if not when:
                continue
            session = event_value(event, "sessionId", "session_id", "conversationId", "conversation_id")
            session_key = f"{path}:{session or 'file'}"
            role = str(event_value(event, "role", "type", "kind", "event") or "").lower()
            if role in {"user", "prompt", "human", "user_message", "user-message"}:
                add(stats, when, None, prompts=1)
            usage = event.get("usage") or event.get("usageMetadata") or event.get("tokens") or {}
            if not isinstance(usage, dict):
                usage = {}
            model = model_id(event_value(event, "model", "modelName", "model_id") or usage.get("model"))
            input_tokens = event_value(usage, "input", "input_tokens", "promptTokenCount")
            output_tokens = event_value(usage, "output", "output_tokens", "candidatesTokenCount", "completion_tokens")
            cache_read = event_value(usage, "cache_read", "cacheReadInputTokens", "cachedContentTokenCount")
            cache_write = event_value(usage, "cache_write", "cacheCreationInputTokens")
            has_usage = any(value not in (None, "") for value in (input_tokens, output_tokens, cache_read, cache_write))
            if has_usage:
                add(stats, when, model, input_tokens=input_tokens, output_tokens=output_tokens,
                    cache_read=cache_read, cache_write=cache_write)
            if session_key not in seen_sessions and role in {
                    "user", "prompt", "human", "user_message", "user-message",
                    "assistant", "model", "response", "assistant_message", "assistant-message"}:
                stats["totalSessions"] += 1
                stats["activeDates"].add(when)
                if when in stats["recentDays"]:
                    stats["recentDays"][when] += 0
                seen_sessions.add(session_key)
    if stats["totalPrompts"] or stats["totalSessions"] or stats["modelUsage"]:
        finish(agent_id, name, stats)


def collect_cursor():
    collect_event_files(
        "cursor", "Cursor Agent",
        [Path.home() / ".cursor"],
        ["*.jsonl", "logs.json", "*transcript*.json", "*session*.json"],
    )


def collect_gemini():
    collect_event_files(
        "gemini", "Gemini CLI",
        [Path.home() / ".gemini/tmp"],
        ["logs.json", "*.jsonl", "*transcript*.json"],
    )


def collect_pi():
    collect_event_files(
        "pi", "Pi",
        [Path.home() / ".pi/agent"],
        ["*.jsonl", "*session*.json", "*transcript*.json"],
    )


def collect_continue():
    collect_event_files(
        "continue", "Continue",
        [Path.home() / ".continue", Path.home() / ".local/share/continue"],
        ["*.jsonl", "*session*.json", "*transcript*.json"],
    )


def finish(agent_id, name, stats, extra=None):
    stats["recentDays"] = [{"date": item, "messageCount": stats["recentDays"][item]} for item in DAYS]
    stats["activeDates"] = sorted(stats["activeDates"])
    stats["activeDays"] = len(stats["activeDates"])
    record = {"schemaVersion": 1, "id": agent_id, "name": name, "ready": True,
              "hasLocalStats": True, "hasPromptStats": stats["totalPrompts"] > 0,
              "tierLabel": "Local usage", "limits": [], "usageStatusText": "",
              "updatedAt": datetime.now().astimezone().isoformat(), **stats, **(extra or {})}
    OUT.mkdir(parents=True, exist_ok=True)
    # The panel watches this directory; rename so it never reads a torn file.
    tmp = OUT / f".{agent_id}.json.tmp"
    tmp.write_text(json.dumps(record, separators=(",", ":")) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(OUT / f"{agent_id}.json")


def collect_crush():
    # Crush keeps token totals per session only; its messages carry the model
    # and timestamp. Spread each session's tokens over its assistant messages
    # so multi-day sessions land on the right days and models.
    stats = blank(); db = connect(Path.home() / ".crush/crush.db")
    if not db: return
    try:
        replies = defaultdict(lambda: defaultdict(int))
        for sid, created, model in db.execute("SELECT session_id,created_at,model FROM messages WHERE role='assistant'"):
            replies[sid][(day(created), model_id(model))] += 1
        for created, in db.execute("SELECT created_at FROM messages WHERE role='user'"):
            add(stats, day(created), None, prompts=1)
        for sid, created, updated, prompt_tokens, completion_tokens in db.execute(
                "SELECT id,created_at,updated_at,prompt_tokens,completion_tokens FROM sessions"):
            add(stats, day(created), None, sessions=1)
            spread = replies.get(sid) or {(day(updated), "unknown"): 1}
            count = sum(spread.values())
            for (when, model), n in spread.items():
                add(stats, when, model, input_tokens=round(prompt_tokens * n / count),
                    output_tokens=round(completion_tokens * n / count))
    finally: db.close()
    finish("crush", "Crush", stats, openrouter_limits())


def collect_opencode():
    # OpenCode records tokens on every assistant message, so count per message
    # rather than per session.
    stats = blank(); db = connect(Path.home() / ".local/share/opencode/opencode.db")
    if not db: return
    try:
        for created, in db.execute("SELECT time_created FROM session"):
            add(stats, day(created), None, sessions=1)
        for created, data in db.execute("SELECT time_created,data FROM message"):
            try:
                msg = json.loads(data)
            except ValueError:
                continue
            if msg.get("role") == "user":
                add(stats, day(created), None, prompts=1)
                continue
            tokens = msg.get("tokens") or {}
            cache = tokens.get("cache") or {}
            add(stats, day(created), model_id(msg.get("modelID")),
                input_tokens=tokens.get("input"),
                output_tokens=int(tokens.get("output") or 0) + int(tokens.get("reasoning") or 0),
                cache_read=cache.get("read"), cache_write=cache.get("write"))
    finally: db.close()
    finish("opencode", "OpenCode", stats, openrouter_limits())


def collect_copilot():
    stats = blank(); db = connect(Path.home() / ".copilot/session-store.db")
    if not db: return
    try:
        for row in db.execute("SELECT model,input_tokens,output_tokens,cache_read_tokens,cache_write_tokens,created_at FROM assistant_usage_events"):
            add(stats, day(row[5]), row[0], prompts=1, input_tokens=row[1], output_tokens=row[2], cache_read=row[3], cache_write=row[4])
    finally: db.close()
    finish("copilot", "Copilot", stats)


def collect_antigravity():
    stats = blank()
    db = connect(Path.home() / ".gemini/antigravity-cli/conversation_summaries.db")
    if not db:
        return
    try:
        rows = db.execute(
            "SELECT conversation_id,last_modified_time,last_user_input_time "
            "FROM conversation_summaries"
        )
        for conversation_id, modified, user_input in rows:
            when = day(user_input) or day(modified)
            if not when:
                continue
            add(stats, when, None, prompts=1, sessions=1)
    finally:
        db.close()
    if stats["totalPrompts"] > 0:
        finish("antigravity", "Google Antigravity", stats, antigravity_limits())


def antigravity_limits():
    """Read Antigravity's authoritative weekly buckets without starting work."""
    command = shutil.which("agy")
    if not command:
        candidate = Path.home() / ".local/share/mise/installs/antigravity-cli/latest/agy"
        command = str(candidate) if candidate.exists() else ""
    if not command:
        return antigravity_previous_limits()

    try:
        result = subprocess.run(
            [command, "-p", "/usage", "--output-format", "json", "--print-timeout", "30s"],
            capture_output=True, text=True, timeout=40, check=False,
        )
        if result.returncode != 0:
            return antigravity_previous_limits()
        response = json.loads(result.stdout)
        groups = ((response.get("command") or {}).get("data") or {}).get("groups") or []
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return antigravity_previous_limits()

    limits = []
    for group in groups:
        group_name = str(group.get("name") or "").strip()
        for bucket in group.get("buckets") or []:
            try:
                remaining = float(bucket["remaining_fraction"])
            except (KeyError, TypeError, ValueError):
                continue
            if not 0 <= remaining <= 1:
                continue
            reset = str(bucket.get("reset_time") or "")
            title = f"{group_name} Weekly" if group_name else "Weekly"
            entry = {
                "label": f"{group_name}: {round((1 - remaining) * 100)}% used" if group_name else "Weekly limit",
                "title": title,
                "percent": round(1 - remaining, 4),
            }
            if reset:
                entry["resetsAt"] = reset
            limits.append(entry)
    if not limits:
        return antigravity_previous_limits()
    return {"limits": limits, "tierLabel": "Antigravity", "limitsFetchedAt": datetime.now().timestamp() * 1000}


def antigravity_previous_limits():
    try:
        record = json.loads((OUT / "antigravity.json").read_text())
        limits = record.get("limits") or []
        if limits:
            return {"limits": limits, "tierLabel": record.get("tierLabel", "Antigravity"),
                    "limitsStale": True, "limitsFetchedAt": record.get("limitsFetchedAt", 0)}
    except (OSError, ValueError, TypeError):
        pass
    return {}


if __name__ == "__main__":
    collect_crush(); collect_opencode(); collect_copilot(); collect_antigravity()
    collect_cursor(); collect_gemini(); collect_pi(); collect_continue()
